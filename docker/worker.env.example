# The worker's connection to Marvin. Copy to ~/.config/screenplay-studio/worker.env (mode 600) and fill in. Never commit the real one.
MARVIN_API_URL=https://your-marvin.example.com
# A token pinned to the one workspace the worker serves (Settings -> API tokens). It reads and writes records and assets there.
MARVIN_USER_TOKEN=
# Seconds between polls for queued jobs (default 3).
# WORKER_POLL_SECONDS=3
# Only for the optional `endpoint` container (a worker that takes jobs by POST): the secret a caller sends as a Bearer token. Make it long and random.
# WORKER_TOKEN=
